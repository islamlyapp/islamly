
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile within the Islamly application, storing preferences and data associated with their unique identifier.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "role": {
          "type": "string",
          "description": "User role: 'student' or 'admin'.",
          "default": "student"
        },
        "preferredCalculationMethod": {
          "type": "string"
        },
        "madhab": {
          "type": "string"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "timeZone": {
          "type": "string"
        },
        "preferredLanguage": {
          "type": "string"
        },
        "preferredLanguageId": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "createdAt",
        "updatedAt"
      ]
    },
    "Video": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Video",
      "type": "object",
      "description": "Represents a scholarly video posted by an admin.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "thumbnail": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "isLive": {
          "type": "boolean"
        },
        "postedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "url",
        "postedAt"
      ]
    },
    "Text": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Text",
      "type": "object",
      "description": "Represents a classical Islamic text, scholarly work, Hadith collection, or Quran.",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "originalTitle": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "publicationYear": {
          "type": "number"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "id",
        "title",
        "type"
      ]
    },
    "Chapter": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "textId": { "type": "string" },
        "title": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "textId", "title", "order"]
    },
    "Passage": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "textId": { "type": "string" },
        "type": { "type": "string" }
      },
      "required": ["id", "textId", "type"]
    },
    "Bookmark": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "targetType", "targetId", "createdAt"]
    },
    "Note": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "passageId": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "passageId", "content", "createdAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous",
      "google.com",
      "discord.com",
      "microsoft.com",
      "phone"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile"
        }
      },
      {
        "path": "/videos/{videoId}",
        "definition": {
          "entityName": "Video"
        }
      },
      {
        "path": "/texts/{textId}",
        "definition": {
          "entityName": "Text"
        }
      }
    ],
    "reasoning": "Admin-controlled videos and streams are stored at the root level for global visibility, while user roles govern publishing permissions."
  }
}
