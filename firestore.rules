rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Islamly Security Rules
     *
     * Core Philosophy: This ruleset enforces a strict user-ownership model for all personal data 
     * while providing a read-only library of Islamic texts and quizzes for authenticated users.
     *
     * Data Structure: User-specific data (profiles, bookmarks, notes, quiz attempts) is nested 
     * under the /users/{userId} path. Global content (texts, quizzes) exists at the root level.
     *
     * Key Security Decisions: 
     * 1. Path-Based Authorization: Access to user data is determined by the {userId} variable 
     *    in the path matching the authenticated user's UID.
     * 2. Relational Integrity: On creation, documents must include a field (id or userId) that 
     *    matches the path variable to ensure data consistency.
     * 3. Immutability: Ownership fields are made immutable on update to prevent data from 
     *    being "re-assigned" to different users.
     * 4. Denormalization: Fields like 'userId' are required within documents to allow for 
     *    efficient queries and rule evaluation without calling get().
     * 5. Read-Only Content: Collections like /texts and /quizzes are restricted to read-only 
     *    access for authenticated users; they have no owner-write permissions defined in this IR.
     */

    // --- Helper Functions ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the user is the owner and the document exists (for update/delete). */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // --- Collection Rules ---

    /**
     * @description Rules for user profile documents.
     * @path /users/{userId}
     * @allow (create) if auth.uid matches userId and data.id matches userId.
     * @deny (update) if attempting to change the 'id' field.
     * @principle Enforces path-based ownership and relational integrity for root user documents.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);

      /**
       * @description Rules for user-specific bookmarks.
       * @path /users/{userId}/bookmarks/{bookmarkId}
       * @allow (create) if auth.uid matches userId and data.userId matches userId.
       * @deny (list) if auth.uid does not match the userId in the path.
       * @principle Ensures users can only manage their own bookmarks.
       */
      match /bookmarks/{bookmarkId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Rules for user-specific personal notes on passages.
       * @path /users/{userId}/notes/{noteId}
       * @allow (get) if auth.uid matches userId.
       * @deny (create) if data.userId is missing or mismatched with path.
       * @principle Restricts note access and creation to the specific owner.
       */
      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);
      }

      /**
       * @description Rules for records of user quiz attempts.
       * @path /users/{userId}/quizAttempts/{quizAttemptId}
       * @allow (create) if data.userId matches the authenticated user.
       * @deny (delete) if the user is not the owner.
       * @principle Maintains private history of quiz performance.
       */
      match /quizAttempts/{quizAttemptId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isExistingOwner(userId);

        /**
         * @description Rules for specific answers within a quiz attempt.
         * @path /users/{userId}/quizAttempts/{quizAttemptId}/quizAnswers/{quizAnswerId}
         * @allow (list) if auth.uid matches the parent userId.
         * @deny (update) if the parent attempt is not owned by the user.
         * @principle Deeply nested ownership check based on parent path variable.
         */
        match /quizAnswers/{quizAnswerId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId);
          allow update: if isExistingOwner(userId);
          allow delete: if isExistingOwner(userId);
        }
      }
    }

    /**
     * @description Rules for the global library of Islamic texts.
     * @path /texts/{textId}
     * @allow (get, list) if the user is signed in.
     * @deny (create, update, delete) for all users (Read-Only).
     * @principle Provides public read access to content while preventing unauthorized modifications.
     */
    match /texts/{textId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;

      /**
       * @description Subcollection of chapters for a text.
       * @path /texts/{textId}/chapters/{chapterId}
       * @allow (list) for any authenticated user.
       * @deny (write) No user-level write access defined.
       * @principle Inherits the public-read, no-write posture of the parent collection.
       */
      match /chapters/{chapterId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if false;
      }

      /**
       * @description Subcollection of passages for a text.
       * @path /texts/{textId}/passages/{passageId}
       * @allow (get) for any authenticated user.
       * @principle Allows granular access to text content for signed-in users.
       */
      match /passages/{passageId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if false;
      }
    }

    /**
     * @description Rules for the global collection of Islamic quizzes.
     * @path /quizzes/{quizId}
     * @allow (get, list) if the user is signed in.
     * @deny (write) No user-level write access defined.
     * @principle Public educational content available to all users.
     */
    match /quizzes/{quizId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;

      /**
       * @description Subcollection of questions for a specific quiz.
       * @path /quizzes/{quizId}/questions/{questionId}
       * @allow (get, list) for any authenticated user.
       * @principle Read-only access to quiz questions for participants.
       */
      match /questions/{questionId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if false;
      }
    }
  }
}