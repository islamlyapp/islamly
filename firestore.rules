
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CORE PHILOSOPHY
     * This ruleset enforces a strict user-ownership model for personal data and a public read-only model 
     * for educational and religious content. It leverages path-based authorization and denormalized 
     * identifiers to ensure high performance and authorization independence.
     *
     * DATA STRUCTURE
     * 1. Public Content: Top-level collections like /authors, /texts, /adhkar, /videos, and the /quran 
     *    and /hadith hierarchies are globally readable.
     * 2. User Data: All user-specific settings, bookmarks, and notes are nested under /users/{userId}. 
     *    Ownership is verified by matching the path's {userId} with the authenticated user's UID.
     */

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // --- USER PROFILE & DATA ---

    match /users/{userId}/user_profiles/{profileId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    match /users/{userId}/bookmarks/{bookmarkId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    match /users/{userId}/notes/{noteId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    // --- PUBLIC CONTENT COLLECTIONS ---

    match /authors/{authorId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /topics/{topicId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /texts/{textId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /adhkar/{adhkarId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /videos/{videoId} {
      /**
       * @description Publicly readable scholarly videos.
       * @path /videos/{videoId}
       */
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /quran/surahs/{surahId} {
      allow get, list: if true;
      allow create, update, delete: if false;

      match /ayahs/{ayahId} {
        allow get, list: if true;
        allow create, update, delete: if false;
      }
    }

    match /tafsir_books/{tafsirBookId} {
      allow get, list: if true;
      allow create, update, delete: if false;

      match /entries/{entryId} {
        allow get, list: if true;
        allow create, update, delete: if false;
      }
    }

    match /hadith_collections/{collectionId} {
      allow get, list: if true;
      allow create, update, delete: if false;

      match /hadiths/{hadithId} {
        allow get, list: if true;
        allow create, update, delete: if false;
      }
    }

    match /hadith_commentary_books/{bookId} {
      allow get, list: if true;
      allow create, update, delete: if false;

      match /entries/{entryId} {
        allow get, list: if true;
        allow create, update, delete: if false;
      }
    }

    match /seerah_events/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    match /quizzes/{quizId} {
      allow get, list: if true;
      allow create, update, delete: if false;

      match /questions/{questionId} {
        allow get, list: if true;
        allow create, update, delete: if false;

        match /answer_options/{optionId} {
          allow get, list: if true;
          allow create, update, delete: if false;
        }
      }
    }
  }
}
